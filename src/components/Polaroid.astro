---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  ratio?: number;
  rotate?: number;
  width: number;
  holder?: 'tape' | 'clip' | 'none';
  settle?: number | false;
  paste?: boolean;
  lift?: boolean;
  class?: string;
  eager?: boolean;
}
const { src, alt, caption, ratio = 1, rotate = 0, width, holder = 'tape', settle = false, paste = false, lift = false, class: cls, eager = false } = Astro.props;
const style = `--ratio:${ratio};--r:${rotate}deg;${settle !== false ? `--d:${settle}ms;` : ''}`;
---
<figure class:list={['polaroid', settle !== false && 'settle', paste && 'paste', lift && 'polaroid--lift', cls]} style={style}>
  {holder === 'tape' && <span class="tape" aria-hidden="true" />}
  {holder === 'clip' && <span class="clip" aria-hidden="true" />}
  <Image src={src} alt={alt} quality={88} widths={[...new Set([Math.round(width), Math.round(width * 1.5), Math.round(width * 2), src.width].filter((w) => w <= src.width))]} sizes={`(max-width: 700px) 80vw, min(${Math.round(width * 1.5)}px, 40vw)`} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
